rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() { return exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} {
      allow read: if request.auth.uid == uid;
      allow write: if false;          // فقط از طریق Console
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth.uid == uid
        && request.resource.data.banned == false && request.resource.data.plan == 'free';
      allow update: if isAdmin() || (request.auth.uid == uid
        && resource.data.banned == false
        && request.resource.data.banned == false
        && request.resource.data.plan == resource.data.plan);
      allow delete: if isAdmin();
    }
  }
}
